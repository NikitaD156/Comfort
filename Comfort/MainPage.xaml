<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Comfort.MainPage"
             xmlns:local="clr-namespace:Comfort">

    <ContentPage.BindingContext>
        <local:ProductionViewModel/>
    </ContentPage.BindingContext>
    
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout>
            <CollectionView ItemsSource="{Binding productions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <FlexLayout Wrap="Wrap" Padding="8">
                            <FlexLayout.Resources>
                                <Style TargetType="Entry">
                                    <Setter Property="Margin" Value="4"/>
                                </Style>
                            </FlexLayout.Resources>
                            <Entry Text="{Binding Type}"/>
                            <Entry Text="{Binding Name}"/>
                            <Entry Text="{Binding Article}"/>
                            <Entry Text="{Binding MinValue}"/>
                            <Entry Text="{Binding Material}"/>
                        </FlexLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Загрузить из Excel" Command="{Binding ImportExcelCommand}"/>
            <!--<Button Text="Перезагрузить данные" Command="{Binding GetCommand}"/>-->
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
